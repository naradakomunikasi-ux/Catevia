# ==============================================================================
# Catevia — Hostinger Web Hosting (LiteSpeed / Apache) Configuration
# Automatically copied from /public/.htaccess into /dist/.htaccess on build
# ==============================================================================

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS on Hostinger (skip localhost)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Protect hidden files/folders (allow .well-known for Let's Encrypt SSL)
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule (^|/)\. - [F,L]

  # 3. Single Page Application (SPA) fallback to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# Security Headers (compatible with Firebase Google Sign-In Popup)
# ==============================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Required so Firebase signInWithPopup works properly across modern browsers
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Never cache index.html so users immediately receive new GitHub deployments
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Long-term immutable cache for Vite hashed assets
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|eot|svg|png|jpg|jpeg|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ==============================================================================
# Gzip Compression
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml font/ttf font/otf
</IfModule>
